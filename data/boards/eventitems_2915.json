tra":0,"EventItemTitle":"Selection of Planning Commission Member of Tree Advocacy Committee","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":7609,"EventItemMatterGuid":"EFE0C0A2-07EC-42F2-B455-F4DB30454E19","EventItemMatterFile":"PC26-306","EventItemMatterName":null,"EventItemMatterType":"Planning Agenda Item","EventItemMatterStatus":"Agenda Ready","EventItemMatterAttachments":[]},{"EventItemId":38553,"EventItemGuid":"B9A45945-CD3A-40B3-9716-E0D6683F5B1A","EventItemLastModifiedUtc":"2026-09-04T14:06:34.747","EventItemRowVersion":"AAAAAACIIuU=","EventItemEventId":2915,"EventItemAgendaSequence":6,"EventItemMinutesSequence":6,"EventItemAgendaNumber":"1.","EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":"1","EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":"\"I move to recommend approval to the Board of Zoning Appeals for a Conditional Use permit for drive-through facility for Bayt Al Mocha Cafe at 226 Maple Avenue West, located within tax map parcel 0384 02 0029A.\"\r\n \r\nOr\r\n \r\n\" I move to recommend approval to the Board of Zoning Appeals for a Conditional Use permit for drive-through facility for Bayt Al Mocha Cafe at 226 Maple Avenue West, located within tax map parcel 0384 02 0029A with the following conditions:\r\n \r\n(Planning Commissioners state conditions of approval individually)\r\n1.\r\n2.\r\n3.\"\r\n \r\nStaff Recommended Conditions:\r\nThe drive-through facility shall be established and operated in substantial conformance with the approved Conditional Use Permit plans and operational narratives, except as modified by these conditions.\r\nThe drive-through may operate with two ordering lanes and provide on-site stacking for a minimum of eleven (11) vehicles, as shown on the approved plans. Vehicle queues associated with the drive-through shall be contained on the property and shall not extend onto Maple Avenue West. \r\nCustomers using the right-hand service lane shall be instructed to proceed to the designated customer waiting area shown on the approved plans. Completed orders shall be delivered to vehicles by restaurant employees using the designated pedestrian route and marked crossing. \r\nExterior ordering speakers shall be directional and oriented toward the drive-through lanes. Speaker volume shall be maintained at the minimum level necessary for customer communication. No amplified music or public-address announcements shall be broadcast through the exterior ordering system. \r\n\r\n\r\n\r\nOr\r\n \r\n“I move to recommend denial to the Board of Zoning Appeals for a Conditional Use permit for drive-through facility for Bayt Al Mocha Cafe at 226 Maple Avenue West, located within tax map parcel 0384 02 0029A.”\r\nOr\r\n \r\nOther action deemed necessary by the Planning Commission.","EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"Request for recommendation for a Conditional Use Permit to the Board of Zoning Appeals for Drive-Through Facility at 226 Maple Ave W","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":7610,"EventItemMatterGuid":"103D9D73-31EB-41A8-9F45-EC6F834A183A","EventItemMatterFile":"PC26-307","EventItemMatterName":null,"EventItemMatterType":"Planning Agenda Item","EventItemMatterStatus":"Agenda Ready","EventItemMatterAttachments":[]},{"EventItemId":38554,"EventItemGuid":"B2904772-F5D9-42CB-B025-45C0BF2A5F5D","EventItemLastModifiedUtc":"2026-09-04T14:08:07.703","EventItemRowVersion":"AAAAAACIIuc=","EventItemEventId":2915,"EventItemAgendaSequence":8,"EventItemMinutesSequence":8,"EventItemAgendaNumber":null,"EventItemVideo":null,"EventItemVid